# ============================================================
# ZEfood Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Firebase Service Account Paths ----
FIREBASE_USER_APP_CREDENTIALS=/path/to/zeefood-user-firebase-adminsdk.json
FIREBASE_STAFF_CREDENTIALS=/path/to/zeefood-staff-firebase-adminsdk.json
FIREBASE_ADMIN_CREDENTIALS=/path/to/zeefood-admin-firebase-adminsdk.json

# ---- Firebase Project IDs ----
FIREBASE_USER_APP_PROJECT_ID=zeefood-c72cd
FIREBASE_STAFF_PROJECT_ID=staff-1ac19
FIREBASE_ADMIN_PROJECT_ID=admin-ca01a

# ---- JWT Secret (for internal tokens) ----
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---- LLM API (Google Gemini — default) ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Alternatively: OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ---- Razorpay ----
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ---- FAISS / RAG ----
FAISS_INDEX_PATH=./data/faiss_index
KNOWLEDGE_BASE_PATH=./data/knowledge_base

# ---- HuggingFace Models ----
# Text sentiment/emotion model
SENTIMENT_MODEL_ID=j-hartmann/emotion-english-distilroberta-base
# Audio emotion regression model (NOT a classification model — uses AutoModel)
AUDIO_EMOTION_MODEL_ID=audeering/wav2vec2-large-robust-12-ft-emotion-msp-dim

# ---- Whisper (Speech-to-Text) ----
WHISPER_MODEL_SIZE=base
# Options: tiny, base, small, medium, large

# ---- App Settings ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
DEBUG=true

# ---- Firebase Storage Buckets ----
USER_APP_STORAGE_BUCKET=your-project-id.appspot.com
