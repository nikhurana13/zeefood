# ============================================================
# ZEfood Backend — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ---- Firebase Credentials ----
# On Render/cloud: paste the FULL JSON content of each service account file
# On local dev: you can use the file path instead (e.g., C:/path/to/file.json)
FIREBASE_USER_APP_CREDENTIALS={"type":"service_account","project_id":"zeefood-c72cd",...}
FIREBASE_STAFF_CREDENTIALS={"type":"service_account","project_id":"staff-1ac19",...}
FIREBASE_ADMIN_CREDENTIALS={"type":"service_account","project_id":"admin-ca01a",...}

# ---- Firebase Project IDs ----
FIREBASE_USER_APP_PROJECT_ID=zeefood-c72cd
FIREBASE_STAFF_PROJECT_ID=staff-1ac19
FIREBASE_ADMIN_PROJECT_ID=admin-ca01a

# ---- Firebase Storage Buckets ----
USER_APP_STORAGE_BUCKET=zeefood-c72cd.appspot.com

# ---- JWT Secret (generate with: openssl rand -hex 32) ----
JWT_SECRET_KEY=your_strong_random_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---- LLM API (Google Gemini) ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ---- OpenAI (optional fallback) ----
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ---- Razorpay ----
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ---- FAISS / RAG ----
FAISS_INDEX_PATH=./data/faiss_index
KNOWLEDGE_BASE_PATH=./data/knowledge_base

# ---- HuggingFace Models ----
SENTIMENT_MODEL_ID=j-hartmann/emotion-english-distilroberta-base
AUDIO_EMOTION_MODEL_ID=audeering/wav2vec2-large-robust-12-ft-emotion-msp-dim

# ---- Whisper ----
WHISPER_MODEL_SIZE=base
# Options: tiny, base, small, medium, large

# ---- App Settings ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS: comma-separated list of allowed origins
# Development:
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Production (update with your actual Vercel URLs):
# CORS_ORIGINS=https://zefood-user.vercel.app,https://zefood-staff.vercel.app,https://zefood-admin.vercel.app

DEBUG=true
