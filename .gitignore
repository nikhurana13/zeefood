# ============================================================
# ZEfood — Root .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.Python

# ---- Virtual Environments ----
venv/
.venv/
env/
ENV/
.env.local

# ---- Environment Variables (secrets — NEVER commit) ----
.env
*.env
!.env.example

# ---- Node / Frontend ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Build Artifacts ----
dist/
dist-ssr/
build/
*.egg-info/
.eggs/

# ---- Python Test / Cache ----
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---- FAISS / Vector Data (auto-generated, can be rebuilt) ----
backend/data/faiss_index/

# ---- Firebase Service Account Keys (NEVER commit) ----
*-firebase-adminsdk-*.json
serviceAccountKey.json
*-service-account*.json

# ---- Editors ----
.idea/
.vscode/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs ----
*.log
logs/

# ---- Docker ----
.docker/

# ---- Misc ----
*.bak
*.tmp
*.orig
